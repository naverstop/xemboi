# 환경 변수 템플릿. 복사해서 .env 로 저장 후 값 채우기
# cp .env.example .env

# ===== App =====
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Security =====
SECRET_KEY=change-me-to-32-bytes-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BIRTH_DATA_AES_KEY=change-me-32-bytes-base64-key

# ===== 관리자 시드 (최초 1회 자동 생성) =====
# ADMIN_EMAILS 는 JSON 배열로 지정. 비우면 관리자 시드 생략.
ADMIN_EMAILS=["admin@example.com"]
ADMIN_INITIAL_PASSWORD=change-me-strong-password

# ===== Database (PostgreSQL Windows 네이티브) =====
DATABASE_URL=postgresql+psycopg://saju:saju@localhost:5432/saju_agent

# ===== Redis (Docker) =====
REDIS_URL=redis://localhost:6379/0

# ===== Qdrant (Docker) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=saju_knowledge

# ===== Ollama (Windows 네이티브) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_TIMEOUT_SEC=180
OLLAMA_KEEP_ALIVE=-1
SSE_HEARTBEAT_SEC=12
PREVIEW_MAX_CHARS=220

# ===== Web Push (PWA, VAPID) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== 외부 LLM (듀얼 LLM 2차 보강) =====
EXTERNAL_LLM_ENABLED=true
# 프로바이더: claude(기본) | gemini(레거시) | off
EXTERNAL_LLM_PROVIDER=claude
# Claude(Anthropic) — 기본
ANTHROPIC_API_KEY=
# auto = 최신 Opus 동적 선택(실패 시 claude-opus-4-8) / 고정하려면 claude-opus-4-8 또는 claude-sonnet-4-6
CLAUDE_MODEL=auto
# Gemini(레거시) — provider=gemini 일 때만 사용
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ===== Embedding =====
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cuda   # cuda or cpu
EMBED_BATCH_SIZE=8

# ===== Pricing =====
CREDITS_PER_QUESTION=1000
CREDITS_PER_KRW=1   # 1원 = 1크레딧

# ===== OAuth (Phase 5) =====
# Redirect URI 는 백엔드 콜백 경로(/api/auth/oauth/<provider>/callback)와 정확히 일치.
# CLIENT_ID/SECRET 비어있거나 'DUMMY' 포함 → mock, 실키 채우면 자동 실연동.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://saju.songstock.art/api/auth/oauth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://saju.songstock.art/api/auth/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=https://saju.songstock.art/login/oauth-success

# ===== Payment (Phase 5) =====
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# ===== YouTube (Phase 6) =====
YOUTUBE_CHANNELS=@慈勇천세원명리교실,@hyunmyung,@행운사주철학관
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
