# ================================================================
#  Xem Bói (VN 사주, xemboi.io) — 베트남 인스턴스 전용 환경설정 예시
#
#  ★★ DB·컬렉션은 한국(사주1)과 '물리적으로 완전히 분리'한다. saju_db / saju_corpus 사용 금지. ★★
#     backend/app/main.py 가 DEFAULT_LOCALE=vi + saju_db(또는 saju_corpus) 조합을 '부팅 거부'한다.
#
#  배포: 이 파일을 D:\saju_vn\.env 로 복사 후 CHANGE_ME 를 실값으로 채운다.
#        서비스 포트 8009, 도메인 xemboi.io. 공용 인프라(Ollama:11434/Qdrant:6333/PG:5432)는 재사용.
# ================================================================

# --- 인스턴스 로케일 (필수: vi) — per-request 미지정 시 기본 + DB 물리분리 가드 기준 ---
DEFAULT_LOCALE=vi

# --- DB : 한국 saju_db 와 '별도 데이터베이스' saju_vn_db (물리 분리) ---
#     운영: CREATE DATABASE saju_vn_db;  후 alembic upgrade head (saju_vn_db 대상)
DATABASE_URL=postgresql+psycopg://saju:CHANGE_ME@127.0.0.1:5432/saju_vn_db

# --- Qdrant : 서버는 공용(:6333), 컬렉션만 분리 saju_vn_corpus ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=saju_vn_corpus

# --- LLM : 공용 Ollama(GPU1) 재사용, vi 모델 = Qwen3 (한국 exaone/qwen2.5 와 무관) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_REFINE_MODEL=qwen3:14b

# --- 인증/보안 : 한국과 다른 '별도 키' (세션·PII 암호화 분리) ---
JWT_SECRET=CHANGE_ME_VN_SECRET
PII_AES_KEY_B64=CHANGE_ME_VN_32B_URLSAFE_BASE64

# --- 도메인 / CORS ---
CORS_ORIGINS=["https://xemboi.io"]

# --- 상거래/소셜로그인 (Phase 4) : VNPay/MoMo·Google+Facebook (Kakao/Toss 미사용) ---
#   실값은 운영에서 주입. Google/Facebook OAuth redirect = https://xemboi.io/api/auth/oauth/*/callback

# ── 프론트(vite) 빌드타임 변수 — frontend 빌드 시 환경에 주입(또는 frontend/.env) ──
#   VITE_DEFAULT_LOCALE=vi   (미설정 시 프론트 기본 ko → 반드시 vi 로)
