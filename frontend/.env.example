# 프론트엔드 환경변수 (Vite) — 실제 값은 frontend/.env.local 에 작성하세요.

# 철학관 상호(채팅 상단 헤더 표시). 비우면 헤더 미표시.
VITE_STUDIO_NAME=

# Google AdSense (외부 광고). CLIENT + 각 슬롯 ID를 채워야 해당 위치에 AdSense가 노출됩니다.
#  - 자체 배너(BannerSlot, 관리자 업로드)가 있으면 그게 우선, 없을 때만 AdSense 폴백.
#  - CLIENT 형식: ca-pub-XXXXXXXXXXXXXXXX,  SLOT 형식: 10자리 숫자 광고단위 ID
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_ANSWER=
# 사이드바 광고 2칸(로그인/다크 위). 각 광고단위 ID. 비우면 자체배너만/없으면 미표시.
VITE_ADSENSE_SLOT_SIDE1=
VITE_ADSENSE_SLOT_SIDE2=

# Web Push(PWA) VAPID 공개키. 백엔드 VAPID_PUBLIC_KEY 와 동일 값. 비우면 푸시 구독 비활성.
VITE_VAPID_PUBLIC_KEY=

# 카카오톡 공유(상담서 PDF 링크 카드) — Kakao Developers > 내 앱 > 앱 키 > "JavaScript 키".
#  (로그인용 KAKAO_CLIENT_ID=REST키와 다른 키다. 같은 앱의 JS키를 넣어야 함.)
#  · 플랫폼 > Web 사이트도메인에 https://saju.songstock.art 등록 + 카카오링크/메시지 사용 설정 필요.
#  · 비우면 공유 메뉴에서 카카오 버튼 자동 숨김(메일/링크복사만 노출).
VITE_KAKAO_JS_KEY=
